{
  "name": "paper-tree",
  "version": "0.1.0",
  "private": true,
  "description": "A small, readable Electron prototype for branching paper reading",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run check:size && tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:api": "tsx scripts/test-api.ts",
    "test:desktop": "tsx scripts/test-desktop.ts",
    "check:size": "node --import tsx scripts/check-size.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.11.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "playwright": "^1.58.0",
    "prettier": "^3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
