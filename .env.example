# Optional developer configuration; normal users configure the API in Settings.
# The app migrates model values only on first use. test:api reads this file directly.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash

# 可选：IEEE 元数据检索 Key，不授予付费全文权限
IEEE_API_KEY=

# NVIDIA AI-Q: 默认由客户端启动本机 127.0.0.1:18181
# AIQ_SERVER_URL=http://127.0.0.1:18181
# AIQ_REPO=/absolute/path/to/aiq
# AIQ_PYTHON=/absolute/path/to/python3
